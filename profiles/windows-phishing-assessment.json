{
  "schema": "arh-scan-profile/1",
  "name": "windows-phishing-assessment",
  "version": 1,
  "os": "windows",
  "purpose": "phishing-assessment",
  "title": "Phishing Assessment",
  "description": "Browser extensions, protection settings, proxy/DNS/hosts tampering and risky downloads",
  "checks": [
    {
      "id": "phish-extensions",
      "title": "Installed browser extensions per user (Chrome, Edge, Brave, Firefox)",
      "category": "Browser",
      "shell": "powershell",
      "command": [
        "function Get-RegValue($path, $name) { try { (Get-ItemProperty -Path $path -Name $name -ErrorAction Stop).$name } catch { $null } }",
        "function Get-UserProfiles {",
        "  @(Get-CimInstance Win32_UserProfile -ErrorAction SilentlyContinue | Where-Object { -not $_.Special -and $_.LocalPath -like '*\\Users\\*' } | ForEach-Object {",
        "    [pscustomobject]@{",
        "      sid = $_.SID",
        "      path = $_.LocalPath",
        "      name = (Split-Path $_.LocalPath -Leaf)",
        "      hiveLoaded = (Test-Path (\"Registry::HKEY_USERS\\\" + $_.SID))",
        "      lastUse = if ($_.LastUseTime) { $_.LastUseTime.ToString('s') } else { $null }",
        "    }",
        "  })",
        "}",
        "",
        "$items = New-Object System.Collections.Generic.List[object]",
        "foreach ($u in (Get-UserProfiles)) {",
        "  $local = Join-Path $u.path 'AppData\\Local'",
        "  $roaming = Join-Path $u.path 'AppData\\Roaming'",
        "  $browsers = @(",
        "    @{ name = 'Chrome'; root = (Join-Path $local 'Google\\Chrome\\User Data') },",
        "    @{ name = 'Edge'; root = (Join-Path $local 'Microsoft\\Edge\\User Data') },",
        "    @{ name = 'Brave'; root = (Join-Path $local 'BraveSoftware\\Brave-Browser\\User Data') }",
        "  )",
        "  foreach ($b in $browsers) {",
        "    if (-not (Test-Path $b.root)) { continue }",
        "    foreach ($profileDir in (Get-ChildItem $b.root -Directory -ErrorAction SilentlyContinue)) {",
        "      $extRoot = Join-Path $profileDir.FullName 'Extensions'",
        "      if (-not (Test-Path $extRoot)) { continue }",
        "      foreach ($extDir in (Get-ChildItem $extRoot -Directory -ErrorAction SilentlyContinue)) {",
        "        $verDir = Get-ChildItem $extDir.FullName -Directory -ErrorAction SilentlyContinue | Sort-Object Name -Descending | Select-Object -First 1",
        "        if (-not $verDir) { continue }",
        "        $manifestPath = Join-Path $verDir.FullName 'manifest.json'",
        "        if (-not (Test-Path $manifestPath)) { continue }",
        "        try {",
        "          $m = Get-Content $manifestPath -Raw -ErrorAction Stop | ConvertFrom-Json",
        "          $name = [string]$m.name",
        "          if ($name -like '__MSG_*') {",
        "            $key = $name -replace '^__MSG_', '' -replace '__$', ''",
        "            $loc = Join-Path $verDir.FullName '_locales\\en\\messages.json'",
        "            if (-not (Test-Path $loc)) {",
        "              $loc = Get-ChildItem (Join-Path $verDir.FullName '_locales') -Recurse -Filter 'messages.json' -ErrorAction SilentlyContinue | Select-Object -First 1 -ExpandProperty FullName",
        "            }",
        "            if ($loc) { try { $msgs = Get-Content $loc -Raw | ConvertFrom-Json; if ($msgs.$key.message) { $name = $msgs.$key.message } } catch {} }",
        "          }",
        "          $perms = @()",
        "          if ($m.permissions) { $perms += @($m.permissions | ForEach-Object { [string]$_ }) }",
        "          if ($m.host_permissions) { $perms += @($m.host_permissions | ForEach-Object { [string]$_ }) }",
        "          $items.Add([pscustomobject]@{ user = $u.name; browser = $b.name; profile = $profileDir.Name; id = $extDir.Name; name = $name; version = [string]$m.version; permissions = $perms })",
        "        } catch {}",
        "      }",
        "    }",
        "  }",
        "  $ffRoot = Join-Path $roaming 'Mozilla\\Firefox\\Profiles'",
        "  if (Test-Path $ffRoot) {",
        "    foreach ($p in (Get-ChildItem $ffRoot -Directory -ErrorAction SilentlyContinue)) {",
        "      $ext = Join-Path $p.FullName 'extensions.json'",
        "      if (-not (Test-Path $ext)) { continue }",
        "      try {",
        "        $data = Get-Content $ext -Raw -ErrorAction Stop | ConvertFrom-Json",
        "        foreach ($a in $data.addons) {",
        "          if ($a.type -ne 'extension' -or $a.location -eq 'app-builtin' -or $a.location -eq 'app-system-defaults') { continue }",
        "          $perms = @()",
        "          if ($a.userPermissions) { $perms = @($a.userPermissions.permissions) + @($a.userPermissions.origins) }",
        "          $items.Add([pscustomobject]@{ user = $u.name; browser = 'Firefox'; profile = $p.Name; id = $a.id; name = $a.defaultLocale.name; version = $a.version; permissions = $perms; active = $a.active })",
        "        }",
        "      } catch {}",
        "    }",
        "  }",
        "}",
        "ConvertTo-Json -InputObject @($items.ToArray()) -Depth 4 -Compress"
      ],
      "format": "json",
      "timeoutSeconds": 90,
      "optional": false,
      "access": "read"
    },
    {
      "id": "phish-settings",
      "title": "SmartScreen, Defender PUA/network protection, Office macro and Outlook content settings",
      "category": "Protection",
      "shell": "powershell",
      "command": [
        "function Get-RegValue($path, $name) { try { (Get-ItemProperty -Path $path -Name $name -ErrorAction Stop).$name } catch { $null } }",
        "function Get-UserProfiles {",
        "  @(Get-CimInstance Win32_UserProfile -ErrorAction SilentlyContinue | Where-Object { -not $_.Special -and $_.LocalPath -like '*\\Users\\*' } | ForEach-Object {",
        "    [pscustomobject]@{",
        "      sid = $_.SID",
        "      path = $_.LocalPath",
        "      name = (Split-Path $_.LocalPath -Leaf)",
        "      hiveLoaded = (Test-Path (\"Registry::HKEY_USERS\\\" + $_.SID))",
        "      lastUse = if ($_.LastUseTime) { $_.LastUseTime.ToString('s') } else { $null }",
        "    }",
        "  })",
        "}",
        "",
        "$pref = $null",
        "try { $pref = Get-MpPreference -ErrorAction Stop } catch {}",
        "$users = @(Get-UserProfiles | Where-Object { $_.hiveLoaded } | ForEach-Object {",
        "  $h = \"Registry::HKEY_USERS\\\" + $_.sid",
        "  [pscustomobject]@{",
        "    user = $_.name",
        "    edgeSmartScreenUser = Get-RegValue ($h + '\\Software\\Microsoft\\Edge\\SmartScreenEnabled') '(default)'",
        "    wordVbaWarnings = Get-RegValue ($h + '\\Software\\Microsoft\\Office\\16.0\\Word\\Security') 'VBAWarnings'",
        "    excelVbaWarnings = Get-RegValue ($h + '\\Software\\Microsoft\\Office\\16.0\\Excel\\Security') 'VBAWarnings'",
        "    wordBlockMacrosFromInternet = Get-RegValue ($h + '\\Software\\Policies\\Microsoft\\Office\\16.0\\Word\\Security') 'blockcontentexecutionfrominternet'",
        "    outlookReadAsPlainText = Get-RegValue ($h + '\\Software\\Microsoft\\Office\\16.0\\Outlook\\Options\\Mail') 'ReadAsPlain'",
        "    outlookBlockExternalContent = Get-RegValue ($h + '\\Software\\Microsoft\\Office\\16.0\\Outlook\\Options\\Mail') 'BlockExtContent'",
        "  }",
        "})",
        "$o = [ordered]@{",
        "  smartScreenExplorer = Get-RegValue 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer' 'SmartScreenEnabled'",
        "  smartScreenPolicy = Get-RegValue 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\System' 'EnableSmartScreen'",
        "  edgeSmartScreenPolicy = Get-RegValue 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Edge' 'SmartScreenEnabled'",
        "  chromeSafeBrowsingPolicy = Get-RegValue 'HKLM:\\SOFTWARE\\Policies\\Google\\Chrome' 'SafeBrowsingProtectionLevel'",
        "  defenderPuaProtection = if ($pref) { [int]$pref.PUAProtection } else { $null }",
        "  defenderNetworkProtection = if ($pref) { [int]$pref.EnableNetworkProtection } else { $null }",
        "  defenderCloudBlockLevel = if ($pref) { [int]$pref.CloudBlockLevel } else { $null }",
        "  defenderMapsReporting = if ($pref) { [int]$pref.MAPSReporting } else { $null }",
        "  users = $users",
        "}",
        "ConvertTo-Json -InputObject ([pscustomobject]$o) -Depth 4 -Compress"
      ],
      "format": "json",
      "timeoutSeconds": 90,
      "optional": false,
      "access": "read"
    },
    {
      "id": "phish-network",
      "title": "Proxy settings per user, DNS servers and hosts-file overrides",
      "category": "Network",
      "shell": "powershell",
      "command": [
        "function Get-RegValue($path, $name) { try { (Get-ItemProperty -Path $path -Name $name -ErrorAction Stop).$name } catch { $null } }",
        "function Get-UserProfiles {",
        "  @(Get-CimInstance Win32_UserProfile -ErrorAction SilentlyContinue | Where-Object { -not $_.Special -and $_.LocalPath -like '*\\Users\\*' } | ForEach-Object {",
        "    [pscustomobject]@{",
        "      sid = $_.SID",
        "      path = $_.LocalPath",
        "      name = (Split-Path $_.LocalPath -Leaf)",
        "      hiveLoaded = (Test-Path (\"Registry::HKEY_USERS\\\" + $_.SID))",
        "      lastUse = if ($_.LastUseTime) { $_.LastUseTime.ToString('s') } else { $null }",
        "    }",
        "  })",
        "}",
        "",
        "$hostsPath = Join-Path $env:SystemRoot 'System32\\drivers\\etc\\hosts'",
        "$hosts = @()",
        "try { $hosts = @(Get-Content $hostsPath -ErrorAction Stop | Where-Object { $_.Trim() -and -not $_.Trim().StartsWith('#') }) } catch {}",
        "$dns = @(Get-DnsClientServerAddress -AddressFamily IPv4 -ErrorAction SilentlyContinue | Where-Object { $_.ServerAddresses } | ForEach-Object { [pscustomobject]@{ interface = $_.InterfaceAlias; servers = @($_.ServerAddresses) } })",
        "$users = @(Get-UserProfiles | Where-Object { $_.hiveLoaded } | ForEach-Object {",
        "  $inet = \"Registry::HKEY_USERS\\\" + $_.sid + '\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings'",
        "  [pscustomobject]@{",
        "    user = $_.name",
        "    proxyEnabled = (Get-RegValue $inet 'ProxyEnable') -eq 1",
        "    proxyServer = Get-RegValue $inet 'ProxyServer'",
        "    autoConfigUrl = Get-RegValue $inet 'AutoConfigURL'",
        "  }",
        "})",
        "$machineProxy = Get-RegValue 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\CurrentVersion\\Internet Settings' 'ProxySettingsPerUser'",
        "$winHttp = (netsh winhttp show proxy 2>$null | Out-String).Trim()",
        "ConvertTo-Json -InputObject ([pscustomobject]@{ users = $users; proxySettingsPerUserPolicy = $machineProxy; winHttpProxy = $winHttp; dns = $dns; hostsEntries = $hosts }) -Depth 4 -Compress"
      ],
      "format": "json",
      "timeoutSeconds": 90,
      "optional": false,
      "access": "read"
    },
    {
      "id": "phish-downloads",
      "title": "Recent executable/script downloads per user (names), archives and macro documents (counts only)",
      "category": "Downloads",
      "shell": "powershell",
      "command": [
        "function Get-RegValue($path, $name) { try { (Get-ItemProperty -Path $path -Name $name -ErrorAction Stop).$name } catch { $null } }",
        "function Get-UserProfiles {",
        "  @(Get-CimInstance Win32_UserProfile -ErrorAction SilentlyContinue | Where-Object { -not $_.Special -and $_.LocalPath -like '*\\Users\\*' } | ForEach-Object {",
        "    [pscustomobject]@{",
        "      sid = $_.SID",
        "      path = $_.LocalPath",
        "      name = (Split-Path $_.LocalPath -Leaf)",
        "      hiveLoaded = (Test-Path (\"Registry::HKEY_USERS\\\" + $_.SID))",
        "      lastUse = if ($_.LastUseTime) { $_.LastUseTime.ToString('s') } else { $null }",
        "    }",
        "  })",
        "}",
        "",
        "$exec = '^\\.(exe|msi|msix|bat|cmd|ps1|js|jse|vbs|vbe|wsf|hta|scr|iso|img|vhd|lnk)$'",
        "$archive = '^\\.(zip|7z|rar|cab)$'",
        "$macro = '^\\.(docm|xlsm|pptm|one)$'",
        "$since = (Get-Date).AddDays(-14)",
        "$users = @(Get-UserProfiles | ForEach-Object {",
        "  $dl = Join-Path $_.path 'Downloads'",
        "  $files = @(Get-ChildItem $dl -File -ErrorAction SilentlyContinue | Where-Object { $_.LastWriteTime -gt $since })",
        "  $execFiles = @($files | Where-Object { $_.Extension -match $exec } | Sort-Object LastWriteTime -Descending | Select-Object -First 25 | ForEach-Object {",
        "    [pscustomobject]@{ name = $_.Name; modified = $_.LastWriteTime.ToString('s'); kb = [math]::Round($_.Length / 1KB); markOfTheWeb = [bool](Get-Item -Path $_.FullName -Stream Zone.Identifier -ErrorAction SilentlyContinue) }",
        "  })",
        "  [pscustomobject]@{",
        "    user = $_.name",
        "    executableFiles = $execFiles",
        "    archiveCount = @($files | Where-Object { $_.Extension -match $archive }).Count",
        "    macroDocumentCount = @($files | Where-Object { $_.Extension -match $macro }).Count",
        "    totalRecentFiles = $files.Count",
        "  }",
        "})",
        "ConvertTo-Json -InputObject @($users) -Depth 4 -Compress"
      ],
      "format": "json",
      "timeoutSeconds": 90,
      "optional": true,
      "access": "read"
    }
  ]
}
