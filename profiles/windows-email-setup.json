{
  "schema": "arh-scan-profile/1",
  "name": "windows-email-setup",
  "version": 1,
  "os": "windows",
  "purpose": "email-setup",
  "title": "Email Setup",
  "description": "Mail client installation, profiles, Microsoft 365 reachability and DNS",
  "checks": [
    {
      "id": "mail-outlook",
      "title": "Outlook / Microsoft 365 installation and per-user profiles",
      "category": "Email",
      "shell": "powershell",
      "command": [
        "function Get-RegValue($path, $name) { try { (Get-ItemProperty -Path $path -Name $name -ErrorAction Stop).$name } catch { $null } }",
        "function Get-UserProfiles {",
        "  @(Get-CimInstance Win32_UserProfile -ErrorAction SilentlyContinue | Where-Object { -not $_.Special -and $_.LocalPath -like '*\\Users\\*' } | ForEach-Object {",
        "    [pscustomobject]@{",
        "      sid = $_.SID",
        "      path = $_.LocalPath",
        "      name = (Split-Path $_.LocalPath -Leaf)",
        "      hiveLoaded = (Test-Path (\"Registry::HKEY_USERS\\\" + $_.SID))",
        "      lastUse = if ($_.LastUseTime) { $_.LastUseTime.ToString('s') } else { $null }",
        "    }",
        "  })",
        "}",
        "",
        "$appPath = Get-RegValue 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths\\OUTLOOK.EXE' '(default)'",
        "$c2r = 'HKLM:\\SOFTWARE\\Microsoft\\Office\\ClickToRun\\Configuration'",
        "$users = @(Get-UserProfiles | ForEach-Object {",
        "  $u = $_",
        "  $profiles = @()",
        "  $default = $null",
        "  if ($u.hiveLoaded) {",
        "    foreach ($ver in '16.0', '15.0') {",
        "      $p = \"Registry::HKEY_USERS\\\" + $u.sid + \"\\Software\\Microsoft\\Office\\\" + $ver + \"\\Outlook\\Profiles\"",
        "      if (Test-Path $p) { $profiles += @(Get-ChildItem $p | ForEach-Object { $_.PSChildName }) }",
        "    }",
        "    $default = Get-RegValue (\"Registry::HKEY_USERS\\\" + $u.sid + \"\\Software\\Microsoft\\Office\\16.0\\Outlook\") 'DefaultProfile'",
        "  }",
        "  $ost = @(Get-ChildItem (Join-Path $u.path 'AppData\\Local\\Microsoft\\Outlook') -Filter '*.ost' -ErrorAction SilentlyContinue | ForEach-Object {",
        "    [pscustomobject]@{ name = $_.Name; sizeGB = [math]::Round($_.Length / 1GB, 2); modified = $_.LastWriteTime.ToString('s') }",
        "  })",
        "  [pscustomobject]@{ user = $u.name; hiveLoaded = $u.hiveLoaded; lastUse = $u.lastUse; profiles = $profiles; defaultProfile = $default; ostFiles = $ost }",
        "})",
        "$o = [ordered]@{",
        "  classicOutlookInstalled = [bool]$appPath",
        "  classicOutlookPath = $appPath",
        "  outlookRunning = [bool](Get-Process -Name OUTLOOK -ErrorAction SilentlyContinue)",
        "  newOutlookInstalled = [bool](Get-AppxPackage -AllUsers -Name 'Microsoft.OutlookForWindows' -ErrorAction SilentlyContinue)",
        "  m365Products = Get-RegValue $c2r 'ProductReleaseIds'",
        "  m365Version = Get-RegValue $c2r 'VersionToReport'",
        "  m365Channel = Get-RegValue $c2r 'UpdateChannel'",
        "  users = $users",
        "}",
        "ConvertTo-Json -InputObject ([pscustomobject]$o) -Depth 5 -Compress"
      ],
      "format": "json",
      "timeoutSeconds": 90,
      "optional": false,
      "access": "read"
    },
    {
      "id": "mail-connectivity",
      "title": "TCP reachability of Microsoft 365 mail endpoints",
      "category": "Email",
      "shell": "powershell",
      "command": [
        "$targets = @(",
        "  @{ host = 'outlook.office365.com'; port = 443 },",
        "  @{ host = 'smtp.office365.com'; port = 587 },",
        "  @{ host = 'login.microsoftonline.com'; port = 443 },",
        "  @{ host = 'autodiscover-s.outlook.com'; port = 443 }",
        ")",
        "$r = @(foreach ($t in $targets) {",
        "  $ok = $false",
        "  $sw = [System.Diagnostics.Stopwatch]::StartNew()",
        "  try {",
        "    $client = New-Object System.Net.Sockets.TcpClient",
        "    $iar = $client.BeginConnect($t.host, $t.port, $null, $null)",
        "    if ($iar.AsyncWaitHandle.WaitOne(4000)) { $client.EndConnect($iar); $ok = $client.Connected }",
        "    $client.Close()",
        "  } catch { $ok = $false }",
        "  $sw.Stop()",
        "  [pscustomobject]@{ host = $t.host; port = $t.port; reachable = $ok; ms = $sw.ElapsedMilliseconds }",
        "})",
        "ConvertTo-Json -InputObject $r -Compress"
      ],
      "format": "json",
      "timeoutSeconds": 90,
      "optional": false,
      "access": "read"
    },
    {
      "id": "mail-dns",
      "title": "MX, autodiscover and SPF records for the signed-in UPN domain",
      "category": "Email",
      "shell": "powershell",
      "command": [
        "$upn = $null",
        "try { $upn = (whoami /upn 2>$null) } catch {}",
        "if ($upn -and $upn.Contains('@')) {",
        "  $domain = $upn.Split('@')[1]",
        "  \"UPN: $upn\"",
        "  \"MX records for $domain :\"",
        "  Resolve-DnsName -Name $domain -Type MX -ErrorAction SilentlyContinue | Select-Object NameExchange, Preference | Format-Table -AutoSize | Out-String -Width 200",
        "  'Autodiscover CNAME:'",
        "  Resolve-DnsName -Name \"autodiscover.$domain\" -Type CNAME -ErrorAction SilentlyContinue | Select-Object Name, NameHost | Format-Table -AutoSize | Out-String -Width 200",
        "  'SPF TXT:'",
        "  Resolve-DnsName -Name $domain -Type TXT -ErrorAction SilentlyContinue | Where-Object { $_.Strings -match 'v=spf1' } | ForEach-Object { $_.Strings -join '' }",
        "} else {",
        "  'No UPN for the evaluating account (local account, or not AD/Entra joined); skipping MX/autodiscover lookup.'",
        "}"
      ],
      "format": "text",
      "timeoutSeconds": 90,
      "optional": true,
      "access": "read"
    }
  ]
}
