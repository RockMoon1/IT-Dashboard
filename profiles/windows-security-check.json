{
  "schema": "arh-scan-profile/1",
  "name": "windows-security-check",
  "version": 2,
  "os": "windows",
  "purpose": "security-check",
  "title": "Security Check",
  "description": "Antivirus, firewall, patching, encryption, accounts and sign-in activity",
  "checks": [
    {
      "id": "sec-defender",
      "title": "Microsoft Defender status",
      "category": "Antivirus",
      "shell": "powershell",
      "command": [
        "try {",
        "  $s = Get-MpComputerStatus -ErrorAction Stop",
        "  $o = [ordered]@{",
        "    available = $true",
        "    amServiceEnabled = $s.AMServiceEnabled",
        "    antivirusEnabled = $s.AntivirusEnabled",
        "    realTimeProtectionEnabled = $s.RealTimeProtectionEnabled",
        "    antispywareEnabled = $s.AntispywareEnabled",
        "    networkInspectionEnabled = $s.NISEnabled",
        "    tamperProtected = $s.IsTamperProtected",
        "    amRunningMode = [string]$s.AMRunningMode",
        "    signatureAgeDays = $s.AntivirusSignatureAge",
        "    signatureVersion = $s.AntivirusSignatureVersion",
        "    lastQuickScan = if ($s.QuickScanEndTime) { $s.QuickScanEndTime.ToString('s') } else { $null }",
        "    lastFullScan = if ($s.FullScanEndTime) { $s.FullScanEndTime.ToString('s') } else { $null }",
        "  }",
        "  ConvertTo-Json -InputObject ([pscustomobject]$o) -Compress",
        "} catch {",
        "  ConvertTo-Json -InputObject ([pscustomobject]@{ available = $false; reason = $_.Exception.Message }) -Compress",
        "}"
      ],
      "format": "json",
      "timeoutSeconds": 90,
      "optional": false,
      "access": "read"
    },
    {
      "id": "sec-av-products",
      "title": "Registered antivirus products (Security Center)",
      "category": "Antivirus",
      "shell": "powershell",
      "command": [
        "try {",
        "  $p = @(Get-CimInstance -Namespace root/SecurityCenter2 -ClassName AntivirusProduct -ErrorAction Stop | ForEach-Object {",
        "    $state = [int]$_.productState",
        "    [pscustomobject]@{",
        "      name = $_.displayName",
        "      productState = $state",
        "      enabled = (($state -band 0x1000) -ne 0)",
        "      upToDate = (($state -band 0x10) -eq 0)",
        "      timestamp = $_.timestamp",
        "    }",
        "  })",
        "  ConvertTo-Json -InputObject $p -Compress",
        "} catch {",
        "  ConvertTo-Json -InputObject @() -Compress",
        "}"
      ],
      "format": "json",
      "timeoutSeconds": 90,
      "optional": true,
      "access": "read"
    },
    {
      "id": "sec-firewall",
      "title": "Windows Firewall profiles",
      "category": "Firewall",
      "shell": "powershell",
      "command": [
        "$p = @(Get-NetFirewallProfile -PolicyStore ActiveStore -ErrorAction SilentlyContinue | Select-Object Name, @{ n = 'Enabled'; e = { [string]$_.Enabled } }, @{ n = 'DefaultInboundAction'; e = { [string]$_.DefaultInboundAction } }, @{ n = 'DefaultOutboundAction'; e = { [string]$_.DefaultOutboundAction } })",
        "ConvertTo-Json -InputObject $p -Compress"
      ],
      "format": "json",
      "timeoutSeconds": 90,
      "optional": false,
      "access": "read"
    },
    {
      "id": "sec-updates",
      "title": "Installed updates (latest 10) and Windows Update state",
      "category": "Updates",
      "shell": "powershell",
      "command": [
        "$h = @(Get-HotFix -ErrorAction SilentlyContinue | Where-Object { $_.InstalledOn } | Sort-Object InstalledOn -Descending | Select-Object -First 10 HotFixID, Description, @{ n = 'InstalledOn'; e = { $_.InstalledOn.ToString('yyyy-MM-dd') } })",
        "$lastSearch = $null; $lastInstall = $null",
        "try {",
        "  $au = (New-Object -ComObject Microsoft.Update.AutoUpdate).Results",
        "  if ($au.LastSearchSuccessDate) { $lastSearch = ([datetime]$au.LastSearchSuccessDate).ToString('s') }",
        "  if ($au.LastInstallationSuccessDate) { $lastInstall = ([datetime]$au.LastInstallationSuccessDate).ToString('s') }",
        "} catch {}",
        "$rebootPending = (Test-Path 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\WindowsUpdate\\Auto Update\\RebootRequired') -or (Test-Path 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Component Based Servicing\\RebootPending')",
        "ConvertTo-Json -InputObject ([pscustomobject]@{ hotfixes = $h; lastSearchSuccess = $lastSearch; lastInstallSuccess = $lastInstall; rebootPending = $rebootPending }) -Depth 3 -Compress"
      ],
      "format": "json",
      "timeoutSeconds": 90,
      "optional": false,
      "access": "read"
    },
    {
      "id": "sec-bitlocker",
      "title": "BitLocker volume status (requires admin)",
      "category": "Encryption",
      "shell": "powershell",
      "command": [
        "try {",
        "  $v = @(Get-BitLockerVolume -ErrorAction Stop | Select-Object MountPoint, @{ n = 'ProtectionStatus'; e = { [string]$_.ProtectionStatus } }, @{ n = 'VolumeStatus'; e = { [string]$_.VolumeStatus } }, EncryptionPercentage, @{ n = 'VolumeType'; e = { [string]$_.VolumeType } })",
        "  ConvertTo-Json -InputObject ([pscustomobject]@{ available = $true; volumes = $v }) -Depth 3 -Compress",
        "} catch {",
        "  ConvertTo-Json -InputObject ([pscustomobject]@{ available = $false; reason = $_.Exception.Message }) -Compress",
        "}"
      ],
      "format": "json",
      "timeoutSeconds": 90,
      "optional": true,
      "access": "read"
    },
    {
      "id": "sec-policies",
      "title": "UAC, SmartScreen, RDP, SMB1, AutoRun and Secure Boot",
      "category": "Hardening",
      "shell": "powershell",
      "command": [
        "function Get-RegValue($path, $name) { try { (Get-ItemProperty -Path $path -Name $name -ErrorAction Stop).$name } catch { $null } }",
        "",
        "$smb1 = $null",
        "try { $smb1 = [bool](Get-SmbServerConfiguration -ErrorAction Stop).EnableSMB1Protocol } catch {}",
        "$secureBoot = $null",
        "try { $secureBoot = Confirm-SecureBootUEFI -ErrorAction Stop } catch {}",
        "$o = [ordered]@{",
        "  uacEnabled = (Get-RegValue 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System' 'EnableLUA') -eq 1",
        "  uacAdminPromptLevel = Get-RegValue 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System' 'ConsentPromptBehaviorAdmin'",
        "  smartScreenExplorer = Get-RegValue 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer' 'SmartScreenEnabled'",
        "  smartScreenPolicy = Get-RegValue 'HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\System' 'EnableSmartScreen'",
        "  rdpEnabled = (Get-RegValue 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server' 'fDenyTSConnections') -eq 0",
        "  smb1Enabled = $smb1",
        "  autorunDisabledForAllDrives = (Get-RegValue 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer' 'NoDriveTypeAutoRun') -eq 255",
        "  secureBoot = $secureBoot",
        "}",
        "ConvertTo-Json -InputObject ([pscustomobject]$o) -Compress"
      ],
      "format": "json",
      "timeoutSeconds": 90,
      "optional": false,
      "access": "read"
    },
    {
      "id": "sec-local-admins",
      "title": "Members of the local Administrators group",
      "category": "Accounts",
      "shell": "powershell",
      "command": [
        "try {",
        "  Get-LocalGroupMember -Group 'Administrators' -ErrorAction Stop | Select-Object Name, ObjectClass, PrincipalSource | Format-Table -AutoSize | Out-String -Width 200",
        "} catch {",
        "  'Unable to enumerate local Administrators: ' + $_.Exception.Message",
        "}"
      ],
      "format": "text",
      "timeoutSeconds": 90,
      "optional": true,
      "access": "read"
    },
    {
      "id": "sec-logins",
      "title": "Failed sign-ins (24 h / 7 d) and recent interactive logons from the Security log",
      "category": "Accounts",
      "shell": "powershell",
      "command": [
        "$since24 = (Get-Date).AddHours(-24)",
        "$since7 = (Get-Date).AddDays(-7)",
        "$failed = @()",
        "try { $failed = @(Get-WinEvent -FilterHashtable @{ LogName = 'Security'; Id = 4625; StartTime = $since7 } -MaxEvents 5000 -ErrorAction Stop) } catch {}",
        "$top = @($failed | ForEach-Object { [string]$_.Properties[5].Value } | Group-Object | Sort-Object Count -Descending | Select-Object -First 5 | ForEach-Object { [pscustomobject]@{ account = $_.Name; failures = $_.Count } })",
        "$logons = @()",
        "try {",
        "  $logons = @(Get-WinEvent -FilterHashtable @{ LogName = 'Security'; Id = 4624; StartTime = $since7 } -MaxEvents 3000 -ErrorAction Stop | Where-Object { [int]$_.Properties[8].Value -in 2, 10, 11 } | Select-Object -First 10 | ForEach-Object {",
        "    [pscustomobject]@{ time = $_.TimeCreated.ToString('s'); account = [string]$_.Properties[5].Value; logonType = [int]$_.Properties[8].Value }",
        "  })",
        "} catch {}",
        "ConvertTo-Json -InputObject ([pscustomobject]@{ failedLogins24h = @($failed | Where-Object { $_.TimeCreated -ge $since24 }).Count; failedLogins7d = $failed.Count; topFailedAccounts = $top; recentInteractiveLogons = $logons }) -Depth 3 -Compress"
      ],
      "format": "json",
      "timeoutSeconds": 120,
      "optional": false,
      "access": "read"
    },
    {
      "id": "sec-services-failed",
      "title": "Automatic services that are not running and Service Control Manager errors (7 days)",
      "category": "Services",
      "shell": "powershell",
      "command": [
        "$stopped = @(Get-CimInstance Win32_Service -ErrorAction SilentlyContinue | Where-Object { $_.StartMode -eq 'Auto' -and $_.State -ne 'Running' -and $_.ExitCode -ne 0 } | Select-Object Name, DisplayName, State, ExitCode)",
        "$scm = @()",
        "try {",
        "  $scm = @(Get-WinEvent -FilterHashtable @{ LogName = 'System'; ProviderName = 'Service Control Manager'; Id = 7000, 7001, 7023, 7024, 7031, 7034; StartTime = (Get-Date).AddDays(-7) } -MaxEvents 200 -ErrorAction Stop | Group-Object Id | ForEach-Object {",
        "    [pscustomobject]@{ eventId = [int]$_.Name; count = $_.Count; sample = (($_.Group | Select-Object -First 1).Message -split '\\r?\\n')[0] }",
        "  })",
        "} catch {}",
        "ConvertTo-Json -InputObject ([pscustomobject]@{ autoServicesNotRunning = $stopped; scmErrors = $scm }) -Depth 3 -Compress"
      ],
      "format": "json",
      "timeoutSeconds": 90,
      "optional": false,
      "access": "read"
    },
    {
      "id": "sec-software",
      "title": "Installed software (machine-wide and per loaded user hive)",
      "category": "Software",
      "shell": "powershell",
      "command": [
        "function Get-RegValue($path, $name) { try { (Get-ItemProperty -Path $path -Name $name -ErrorAction Stop).$name } catch { $null } }",
        "function Get-UserProfiles {",
        "  @(Get-CimInstance Win32_UserProfile -ErrorAction SilentlyContinue | Where-Object { -not $_.Special -and $_.LocalPath -like '*\\Users\\*' } | ForEach-Object {",
        "    [pscustomobject]@{",
        "      sid = $_.SID",
        "      path = $_.LocalPath",
        "      name = (Split-Path $_.LocalPath -Leaf)",
        "      hiveLoaded = (Test-Path (\"Registry::HKEY_USERS\\\" + $_.SID))",
        "      lastUse = if ($_.LastUseTime) { $_.LastUseTime.ToString('s') } else { $null }",
        "    }",
        "  })",
        "}",
        "",
        "$keys = @(",
        "  @{ scope = 'machine'; path = 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*' },",
        "  @{ scope = 'machine-32'; path = 'HKLM:\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*' }",
        ")",
        "foreach ($u in (Get-UserProfiles | Where-Object { $_.hiveLoaded })) {",
        "  $keys += @{ scope = 'user:' + $u.name; path = 'Registry::HKEY_USERS\\' + $u.sid + '\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*' }",
        "}",
        "$apps = foreach ($k in $keys) {",
        "  Get-ItemProperty -Path $k.path -ErrorAction SilentlyContinue | Where-Object { $_.DisplayName -and -not $_.SystemComponent } | ForEach-Object {",
        "    [pscustomobject]@{ name = [string]$_.DisplayName; version = [string]$_.DisplayVersion; publisher = [string]$_.Publisher; installDate = [string]$_.InstallDate; scope = $k.scope }",
        "  }",
        "}",
        "$apps = @($apps | Sort-Object name, version -Unique)",
        "ConvertTo-Json -InputObject $apps -Depth 2 -Compress"
      ],
      "format": "json",
      "timeoutSeconds": 90,
      "optional": true,
      "access": "read"
    }
  ]
}
