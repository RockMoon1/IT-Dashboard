{
  "name": "arh-it-dashboard",
  "productName": "ARH IT Dashboard",
  "version": "0.1.0",
  "description": "Electron + Vue 3 IT management dashboard: device detection, remote diagnostics over WinRM/SSH, and logging into the ARH IT Obsidian vault",
  "private": true,
  "main": "./out/main/index.js",
  "author": "ARH IT",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit --composite false",
    "typecheck:web": "vue-tsc -p tsconfig.web.json --noEmit --composite false",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/ssh2": "^1.15.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^3.1.0",
    "prettier": "^3.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  }
}
