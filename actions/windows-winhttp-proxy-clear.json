{
  "schema": "arh-action/1",
  "name": "windows-winhttp-proxy-clear",
  "version": 1,
  "os": "windows",
  "access": "write",
  "category": "Network",
  "title": "Clear the system (WinHTTP) proxy",
  "description": "Resets the machine-wide WinHTTP proxy to direct (netsh winhttp reset proxy). Windows Update, Defender and other services use it. It does not change the per-user proxy that browsers use; the preview shows those for each signed-in account. Check first that the site does not use a proxy on purpose.",
  "impact": "quiet",
  "reversible": true,
  "undo": "",
  "manualUndo": "netsh winhttp set proxy proxy-server=\"<the proxy before>\" bypass-list=\"<the bypass list before>\"",
  "abortable": false,
  "concurrent": false,
  "fixes": [],
  "shell": "powershell",
  "timeoutSeconds": 60,
  "settleSeconds": 0,
  "params": [],
  "measure": [
    "$v = (Get-ItemProperty -Path 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\\Connections' -ErrorAction SilentlyContinue).WinHttpSettings",
    "$server = ''; $bypass = ''",
    "if ($v -and $v.Length -ge 16) {",
    "  $n = [BitConverter]::ToInt32($v, 12)",
    "  if ($n -gt 0 -and 16 + $n -le $v.Length) {",
    "    $server = [Text.Encoding]::ASCII.GetString($v, 16, $n)",
    "    if (20 + $n -le $v.Length) {",
    "      $m = [BitConverter]::ToInt32($v, 16 + $n)",
    "      if ($m -gt 0 -and 20 + $n + $m -le $v.Length) { $bypass = [Text.Encoding]::ASCII.GetString($v, 20 + $n, $m) }",
    "    }",
    "  }",
    "}",
    "Add-ArhItem 'WinHTTP proxy' $(if ($server) { $server } else { 'direct' })",
    "Add-ArhItem 'WinHTTP bypass list' $(if ($bypass) { $bypass } else { 'none' })",
    "foreach ($k in @(Get-ChildItem Registry::HKEY_USERS -ErrorAction SilentlyContinue | Where-Object { $_.PSChildName -match '^S-1-5-21-[0-9-]+$' })) {",
    "  $p = Get-ItemProperty -Path \"Registry::HKEY_USERS\\$($k.PSChildName)\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\" -ErrorAction SilentlyContinue",
    "  if (-not $p) { continue }",
    "  $who = $k.PSChildName",
    "  try { $who = (New-Object Security.Principal.SecurityIdentifier $k.PSChildName).Translate([Security.Principal.NTAccount]).Value } catch { }",
    "  $desc = $(if ($p.ProxyEnable -eq 1) { \"proxy $($p.ProxyServer)\" } else { 'no proxy' }) + $(if ($p.AutoConfigURL) { \", auto-config $($p.AutoConfigURL)\" } else { '' })",
    "  Add-ArhInfo \"Browser proxy for $who\" $desc",
    "}",
    "if ($server) { Set-ArhPlan $true \"Clear the system proxy $server\" } else { Set-ArhPlan $false 'Already direct (no system proxy)' }"
  ],
  "apply": [
    "$out = Invoke-ArhNative 'netsh.exe' 'winhttp' 'reset' 'proxy'",
    "$code = $LASTEXITCODE",
    "Add-ArhNote $out",
    "exit $code"
  ]
}
